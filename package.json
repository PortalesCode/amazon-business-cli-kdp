{
  "name": "amazon-business-cli-kdp",
  "version": "0.1.1",
  "type": "module",
  "description": "Workspace-isolated Amazon KDP research CLI and engine",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PortalesCode/amazon-business-cli-kdp.git"
  },
